# Generate two DIFFERENT keys with: python -c "import secrets; print(secrets.token_hex(32))"
STAGE_API_KEY=
STAGE_WORKER_KEY=
STAGE_BACKEND=wan-native
STAGE_API_URL=http://127.0.0.1:8000
STAGE_CORS_ORIGINS=
STAGE_LEASE_SECONDS=180
# GPU worker only; set absolute paths on that host.
# WAN_PYTHON=/opt/wan-venv/bin/python
# WAN_REPO=/opt/ism-wan-stage/vendor/Wan2.2
# WAN_MODEL_DIR=/opt/ism-wan-stage/models/Wan2.2-TI2V-5B
WAN_JOB_TIMEOUT_SECONDS=3600
